# Copy to .env and fill in. .env is gitignored and must never be committed.
# Each provider is called directly over HTTPS; there is no broker key.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Directory holding non-distributed prompt profiles, e.g. production.txt.
# Leave unset to use the bundled 'reference' profile.
# VYAPTI_PROMPT_DIR=/path/to/private/prompts
